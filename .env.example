# ── Required ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional: MLflow (defaults to local SQLite) ───────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
# For remote: MLFLOW_TRACKING_URI=http://localhost:5000

# ── Optional: Database (defaults to local SQLite) ─────────────────
DATABASE_URL=sqlite:///earnml.db
# For Postgres: DATABASE_URL=postgresql://earnml:earnml@localhost:5432/earnml

# ── Optional: Redis cache ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App config ───────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
